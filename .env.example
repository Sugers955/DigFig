# DigFig 环境变量样例
# 复制为 .env 后填写真实值；.env 不入库（见 .gitignore）

# ---- 模型服务 ----
DIGFIG_MODEL_BASE_URL=https://api.example.com/v1
DIGFIG_MODEL_API_KEY=
DIGFIG_MODEL_DEFAULT=
DIGFIG_MODEL_TIMEOUT=120

# ---- 数据库 ----
DIGFIG_DB_HOST=127.0.0.1
DIGFIG_DB_PORT=5432
DIGFIG_DB_NAME=digfig
DIGFIG_DB_USER=digfig
DIGFIG_DB_PASSWORD=

# ---- 队列与缓存 ----
DIGFIG_REDIS_URL=redis://127.0.0.1:6379/0

# ---- 控制台与权限 ----
DIGFIG_AUTH_MODE=local            # local | sso | ldap
DIGFIG_AUTH_ISSUER=
DIGFIG_ADMIN_EMAIL=
DIGFIG_ADMIN_PASSWORD=
DIGFIG_SESSION_SECRET=

# ---- 执行留痕 ----
DIGFIG_TRACE_LEVEL=standard       # minimal | standard | full
DIGFIG_TRACE_RETENTION_DAYS=90

# ---- 服务 ----
DIGFIG_SERVER_PORT=8000
DIGFIG_WEB_PORT=3000
DIGFIG_LOG_LEVEL=info
